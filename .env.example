# Desenvolvimento local. Copie para .env e use npm run start:env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
ALLCREDIT_DB=database/allcredit.sqlite
# Produção Railway: NODE_ENV=production; HOST=0.0.0.0; ALLCREDIT_DB=/data/allcredit.sqlite
# Monte um Volume em /data. APP_ORIGIN usa HTTPS ou RAILWAY_PUBLIC_DOMAIN automaticamente.
